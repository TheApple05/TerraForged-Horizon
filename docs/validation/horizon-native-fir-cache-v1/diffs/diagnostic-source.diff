+// QA-only diagnostics: no hit logging, at most 2,000 events across this process.
+static QA_EVENTS: AtomicUsize = AtomicUsize::new(0);
+static QA_ZERO: OnceLock<Instant> = OnceLock::new();
+static QA_ENABLED: OnceLock<bool> = OnceLock::new();
+fn qa_trace(message: std::fmt::Arguments<'_>) {
+    if !*QA_ENABLED.get_or_init(|| std::env::var_os("HORIZON_QA_TILE_TRACE").is_some()) {
+        return;
+    }
+    if let Ok(event) = QA_EVENTS.fetch_update(Ordering::Relaxed, Ordering::Relaxed, |n| {
+        (n < 2_000).then_some(n + 1)
+    }) {
+        let _ = writeln!(
+            std::io::stderr().lock(),
+            "QA_TILE event={}/2000 elapsed_s={:.6} thread={:?} {message}",
+            event + 1,
+            QA_ZERO.get_or_init(Instant::now).elapsed().as_secs_f64(),
+            std::thread::current().id(),
+        );
+    }
+}
